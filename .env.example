# Copy to .env and export the variables you need. Never commit .env.
# Live mode is off unless LIVE_LLM=1. CI and the default demo do not use it.

LIVE_LLM=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional per-role override. Falls back to LLM_MODEL.
LLM_MODEL_SCHEDULER=
LLM_MAX_OUTPUT_TOKENS=512

# Required to start live mode. Must be > 0. No vendor prices are stored in the repo.
MAX_LIVE_SPEND_USD=
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=
# Optional. Unset means cached prompt tokens are billed at the full input price.
# The reservation before the call still uses that full price: it cannot see the cache.
LLM_PRICE_CACHED_PER_MTOK=
# If prices are unset, live mode also requires this cap and reports cost as unknown.
MAX_LIVE_TOKENS=

# Kill switch. 0 disables every external tool (nothing is written to the outbox).
EXTERNAL_TOOLS_ENABLED=1

# Simulated accounting for the scripted provider only. Not a vendor price.
SIM_PRICE_IN_PER_MTOK=0
SIM_PRICE_OUT_PER_MTOK=0
MAX_COST_USD=1
MAX_TURNS=8
MAX_TOOL_CALLS=16
HOLD_TTL_SECONDS=900
APPROVAL_TTL_SECONDS=86400
